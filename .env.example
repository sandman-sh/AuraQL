# =====================================================================
# Aura Analytics - Environment Variables Template
# =====================================================================
# For Local Development: Copy this file to `.env` and fill in your keys.
# For Vercel Deployment: Add these in your Vercel Project Settings -> Environment Variables.
# Note: In Vite, all variables exposed to the browser MUST start with VITE_.
# =====================================================================

# 1. Primary AI Provider API Keys (Pick one or provide any):
# OpenAI Key (e.g. gpt-4o, o3-mini, o1)
VITE_OPENAI_API_KEY=

# Anthropic Key (e.g. claude-3-7-sonnet-20250219, claude-3-5-sonnet)
VITE_ANTHROPIC_API_KEY=

# Google Gemini Key (e.g. gemini-2.0-flash, gemini-2.0-pro)
VITE_GEMINI_API_KEY=

# 2. Optional: Set default active provider (openai | anthropic | gemini | smart)
# Default is 'openai', or auto-detected based on which key is present.
VITE_AI_PROVIDER=openai

# 3. Optional: Override model name
# VITE_AI_MODEL=gpt-4o

# 4. Optional: Custom Remote WebMCP Bridge URL (Default is http://localhost:3001)
# If you deploy mcp-bridge.mjs to Render/Fly.io, paste the public URL here:
# VITE_BRIDGE_URL=https://auraql-bridge.onrender.com
